# Local development values only. Replace with real, non-committed values in .env.
POSTGRES_DB=todo_app
POSTGRES_USER=todo_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=5173
DATABASE_URL=postgresql://todo_app:change-me-for-local-development@db:5432/todo_app
# Required for native browser push reminders. Generate unique values with:
# npx web-push generate-vapid-keys
# Leave these blank until valid keys are available; placeholder values are invalid.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
